# Optional live LLM provider credential.
# Keep real keys only in your local .env or deployment secret manager.
# If unset, Knowledge AI keeps its deterministic evidence-only fallback available.
GEMINI_API_KEY=

# Public application URL used for links/callbacks where applicable.
# Local default:
APP_URL=http://localhost:3000


# Phase 6 integrations
# Generate a long random value (32+ characters) and keep it secret.
INTEGRATION_CREDENTIAL_KEY=

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in Google Cloud Console.
# Example: http://localhost:3000/api/integrations/google-drive/oauth/callback
GOOGLE_DRIVE_REDIRECT_URI=


# Microsoft OneDrive / Microsoft Graph delegated OAuth.
MICROSOFT_ONEDRIVE_CLIENT_ID=
MICROSOFT_ONEDRIVE_CLIENT_SECRET=
# Example: http://localhost:3000/api/integrations/onedrive/oauth/callback
MICROSOFT_ONEDRIVE_REDIRECT_URI=
# "common" supports work/school and personal Microsoft accounts when the app registration allows them.
MICROSOFT_ONEDRIVE_TENANT_ID=common


# Public browser configuration for the official Google Drive Picker.
# The client ID is public OAuth application metadata, not a secret.
VITE_GOOGLE_DRIVE_CLIENT_ID=
# Google Cloud project number / Drive App ID.
VITE_GOOGLE_DRIVE_APP_ID=



# Legacy unauthenticated browser compatibility.
# Keep false by default. Enable only for explicit local/demo/test compatibility.
# This flag is ignored in NODE_ENV=production.
KNOWLEDGE_AI_ALLOW_DEFAULT_WEB=false

# Production persistence transition.
# Leave unset/file during legacy development; use postgres only with DATABASE_URL.
KNOWLEDGE_AI_PERSISTENCE_MODE=file
DATABASE_URL=
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
