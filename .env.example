# Runtime deployment baseline.
# Production supervisors/images MUST set NODE_ENV=production explicitly.
NODE_ENV=
# Production already emits structured JSON operational events by default.
# Set true to opt into JSON operational events outside production too.
KNOWLEDGE_AI_OPERATIONAL_JSON_LOGS=
# Optional operational tuning; defaults shown below.
KNOWLEDGE_AI_READINESS_TIMEOUT_MS=2000
KNOWLEDGE_AI_DB_SLOW_QUERY_MS=1000
KNOWLEDGE_AI_WORKER_READINESS_INTERVAL_MS=15000
KNOWLEDGE_AI_WORKER_READINESS_MAX_STALENESS_MS=30000

# H3 runtime edge and graceful-shutdown contract.
# PORT is the HTTP listen port for the web process.
PORT=3000
# Exact number of trusted reverse-proxy hops. Keep 0 when no trusted proxy
# sits in front of the app. Never use unrestricted Express trust-proxy=true.
KNOWLEDGE_AI_TRUST_PROXY_HOPS=0
# General API body limits. Large PDF/Dataset ingestion remains multipart and
# keeps its route-specific limits.
KNOWLEDGE_AI_JSON_BODY_LIMIT_KB=1024
KNOWLEDGE_AI_URLENCODED_BODY_LIMIT_KB=256
# Outer application request bound. Reverse proxy/body-size policy must allow
# at least this value if the 10 x 25 MiB PDF upload contract is exposed.
KNOWLEDGE_AI_MAX_REQUEST_BODY_MB=260
# Shared bounded drain budget for web/worker termination.
KNOWLEDGE_AI_SHUTDOWN_TIMEOUT_MS=30000
# HSTS ownership is explicit. "proxy" means the trusted TLS terminator emits
# HSTS. "app" is only valid with trusted proxy hops > 0 and HTTPS forwarded.
KNOWLEDGE_AI_HSTS_OWNER=proxy
# Dedicated worker supervisor health surface. Default loopback keeps it private.
# Bind 0.0.0.0 only on a private/unrouted worker network when the platform
# requires pod/container HTTP probes.
KNOWLEDGE_AI_WORKER_HEALTH_HOST=127.0.0.1
KNOWLEDGE_AI_WORKER_HEALTH_PORT=3001

# Optional live LLM provider credential.
# Keep real keys only in your local .env or deployment secret manager.
# If unset, Knowledge AI keeps its deterministic evidence-only fallback available.
GEMINI_API_KEY=
# Optional model override (non-secret).
KNOWLEDGE_AI_GEMINI_MODEL=

# Production browser origin (non-secret, security-critical configuration).
# Example: https://knowledge.example.com
KNOWLEDGE_AI_PUBLIC_ORIGIN=

# One-time initial OWNER bootstrap.
# Token is a deployment secret; use a long random value and rotate/remove it
# after bootstrap is consumed. Account ID is non-secret configuration.
KNOWLEDGE_AI_BOOTSTRAP_TOKEN=
KNOWLEDGE_AI_BOOTSTRAP_ACCOUNT_ID=

# Public application URL used for links/callbacks where applicable.
# Local default:
APP_URL=http://localhost:3000


# Integration OAuth managed-secret boundary (Track F2).
# Active key ID is non-secret. The keyring JSON IS a deployment secret.
# Each JSON value must be base64 for exactly 32 random bytes.
# Rotation: add a new key, switch the active ID, re-encrypt/rotate records,
# then remove the retired key only after no secret version depends on it.
KNOWLEDGE_AI_SECRET_ACTIVE_KEY_ID=
KNOWLEDGE_AI_SECRET_KEYRING_JSON=

# Legacy pre-F2 OAuth credential-file key.
# Keep only while migrating data/integration_credentials.json records.
# New PostgreSQL OAuth credentials do not use this key.
INTEGRATION_CREDENTIAL_KEY=

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in Google Cloud Console.
# Example: http://localhost:3000/api/integrations/google-drive/oauth/callback
GOOGLE_DRIVE_REDIRECT_URI=


# Microsoft OneDrive / Microsoft Graph delegated OAuth.
MICROSOFT_ONEDRIVE_CLIENT_ID=
MICROSOFT_ONEDRIVE_CLIENT_SECRET=
# Example: http://localhost:3000/api/integrations/onedrive/oauth/callback
MICROSOFT_ONEDRIVE_REDIRECT_URI=
# "common" supports work/school and personal Microsoft accounts when the app registration allows them.
MICROSOFT_ONEDRIVE_TENANT_ID=common


# Public browser configuration for the official Google Drive Picker.
# The client ID is public OAuth application metadata, not a secret.
VITE_GOOGLE_DRIVE_CLIENT_ID=
# Google Cloud project number / Drive App ID.
VITE_GOOGLE_DRIVE_APP_ID=



# Legacy unauthenticated browser compatibility.
# Keep false by default. Enable only for explicit local/demo/test compatibility.
# This flag is ignored in NODE_ENV=production.
KNOWLEDGE_AI_ALLOW_DEFAULT_WEB=false

# Legacy/prototype HTTP compatibility.
# Default deny. Enable only for explicit local/demo/test compatibility.
# This flag is ignored in NODE_ENV=production.
KNOWLEDGE_AI_ALLOW_LEGACY_PROTOTYPE_ROUTES=false

# Runtime process ownership (Track E1).
# In NODE_ENV=production this must be explicitly set.
# web      = HTTP/API only; no autonomous worker loops
# worker   = dedicated background worker; no HTTP server entrypoint
# combined = single-process compatibility mode (HTTP + worker loops)
# Development defaults: server=combined, worker entrypoint=worker.
KNOWLEDGE_AI_PROCESS_ROLE=

# Production persistence transition.
# Leave unset/file during legacy development; use postgres only with DATABASE_URL.
# Dedicated worker runtime requires postgres.
KNOWLEDGE_AI_PERSISTENCE_MODE=file
DATABASE_URL=
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# Durable source/object storage (Track C3+).
# Production PostgreSQL document and Dataset imports require an S3-compatible backend.
# Works with AWS S3 and S3-compatible services such as Cloudflare R2.
SOURCE_STORAGE_BACKEND=s3
SOURCE_STORAGE_BUCKET=
SOURCE_STORAGE_REGION=
# Optional custom S3-compatible endpoint. Leave blank for AWS S3.
SOURCE_STORAGE_ENDPOINT=
# Optional static credentials. Prefer deployment/IAM credentials on AWS.
# If one is set, both must be set.
SOURCE_STORAGE_ACCESS_KEY_ID=
SOURCE_STORAGE_SECRET_ACCESS_KEY=
# Usually false for AWS S3; some S3-compatible providers/test stacks require true.
SOURCE_STORAGE_FORCE_PATH_STYLE=false


# G3 isolated recovery validation.
# This workflow is read-only against an externally restored NON-PRODUCTION target.
# It refuses production/same-database/same-bucket targets.
KNOWLEDGE_AI_BUILD_ID=
KNOWLEDGE_AI_RECOVERY_ALLOW=false
KNOWLEDGE_AI_RECOVERY_TARGET_ENV=recovery
KNOWLEDGE_AI_RECOVERY_DATABASE_URL=
KNOWLEDGE_AI_RECOVERY_DATABASE_SSL=disable
KNOWLEDGE_AI_RECOVERY_STORAGE_BACKEND=s3
KNOWLEDGE_AI_RECOVERY_STORAGE_BUCKET=
KNOWLEDGE_AI_RECOVERY_STORAGE_REGION=
KNOWLEDGE_AI_RECOVERY_STORAGE_ENDPOINT=
KNOWLEDGE_AI_RECOVERY_STORAGE_ACCESS_KEY_ID=
KNOWLEDGE_AI_RECOVERY_STORAGE_SECRET_ACCESS_KEY=
KNOWLEDGE_AI_RECOVERY_STORAGE_FORCE_PATH_STYLE=false
# Provider-neutral evidence supplied by the managed backup/restore control plane.
# Never include credentials or secret values.
# Example shape:
# {"evidenceSource":"backup-control-plane","checkedAt":0,"latestRecoveryPointAt":0,"continuousBackupEnabled":true,"pitrEnabled":true,"estimatedRestoreMinutes":30,"backupBuildId":"<build-id>"}
KNOWLEDGE_AI_RECOVERY_RELATIONAL_EVIDENCE_JSON=
# Example shape:
# {"evidenceSource":"restore-control-plane","restoredAt":0,"recoveryPointAt":0,"backupBuildId":"<build-id>"}
KNOWLEDGE_AI_RECOVERY_RESTORE_EVIDENCE_JSON=
