    "check:telemetry-integrity": "tsx scripts/check-telemetry-integrity.ts",
    "benchmark:unseen": "tsx scripts/run-unseen-benchmark.ts",
    "benchmark:unseen:gemini": "tsx scripts/run-live-gemini-benchmark.ts",
    "check:xlsx-schema": "tsx scripts/check-xlsx-schema-correction.ts",
    "check:deterministic-analytics": "tsx scripts/check-deterministic-analytics.ts",
